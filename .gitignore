# This .gitignore is for a .NET / Avalonia solution.
# Base generated by `dotnet new gitignore`, trimmed and extended for Avalonia + Android.

# dotenv files
.env

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Mono auto generated files
mono_crash.*

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
artifacts/

# Visual Studio cache/options directory
.vs/

# JetBrains Rider
.idea/
*.sln.iml

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Test results
[Tt]est[Rr]esult*/
coverage*.json
coverage*.xml
coverage*.info
*.coverage
*.coveragexml

# NuGet
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets

# Publish output
publish/
*.pubxml

# Android build output and signing
*.apk
*.aab
*.keystore
*.jks
*.keystore.b64
*.jks.b64

# Local SQLite data (if the app is ever run from a repo checkout instead of the platform app-data path)
*.db
*.db-shm
*.db-wal

# OS cruft
.DS_Store
Thumbs.db
ehthumbs.db

# One-off GitHub bootstrap scripts (not part of the app)
/bootstrap-github.sh
/seed-backlog.sh
