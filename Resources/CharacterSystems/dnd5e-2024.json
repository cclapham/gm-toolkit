{
  "formatVersion": 1,
  "id": "dnd5e-2024",
  "name": "D&D 5e (2024)",
  "version": "1.0.0",
  "author": "GM Toolkit",
  "description": "D&D 5th Edition (2024 revision of the Player's Handbook and Monster Manual). A separate profile from dnd5e-2014, not a variant: species replaces race, backgrounds grant ability score increases plus an origin feat, weapons carry a mastery property, and Initiative and Proficiency Bonus are now explicit, proficiency-gated stats rather than a bare ability modifier or a background-derived number.",
  "pcFields": [
    {
      "key": "strength",
      "label": "Strength",
      "type": "number",
      "helpText": "Physical power and athletic prowess. In the 2024 rules, the six ability scores after any increases are recorded here directly; increases now come from your background (2 points to distribute among three abilities), not your species.",
      "min": 1,
      "max": 30,
      "precision": 0,
      "default": 10
    },
    {
      "key": "dexterity",
      "label": "Dexterity",
      "type": "number",
      "helpText": "Agility, reflexes, and balance.",
      "min": 1,
      "max": 30,
      "precision": 0,
      "default": 10
    },
    {
      "key": "constitution",
      "label": "Constitution",
      "type": "number",
      "helpText": "Health, stamina, and vital force.",
      "min": 1,
      "max": 30,
      "precision": 0,
      "default": 10
    },
    {
      "key": "intelligence",
      "label": "Intelligence",
      "type": "number",
      "helpText": "Reason and memory.",
      "min": 1,
      "max": 30,
      "precision": 0,
      "default": 10
    },
    {
      "key": "wisdom",
      "label": "Wisdom",
      "type": "number",
      "helpText": "Awareness and insight.",
      "min": 1,
      "max": 30,
      "precision": 0,
      "default": 10
    },
    {
      "key": "charisma",
      "label": "Charisma",
      "type": "number",
      "helpText": "Force of personality and presence.",
      "min": 1,
      "max": 30,
      "precision": 0,
      "default": 10
    },
    {
      "key": "strMod",
      "label": "Strength Modifier",
      "type": "derived",
      "formula": "(strength - 10) / 2",
      "precision": 0,
      "rounding": "floor"
    },
    {
      "key": "dexMod",
      "label": "Dexterity Modifier",
      "type": "derived",
      "formula": "(dexterity - 10) / 2",
      "precision": 0,
      "rounding": "floor"
    },
    {
      "key": "conMod",
      "label": "Constitution Modifier",
      "type": "derived",
      "formula": "(constitution - 10) / 2",
      "precision": 0,
      "rounding": "floor"
    },
    {
      "key": "intMod",
      "label": "Intelligence Modifier",
      "type": "derived",
      "formula": "(intelligence - 10) / 2",
      "precision": 0,
      "rounding": "floor"
    },
    {
      "key": "wisMod",
      "label": "Wisdom Modifier",
      "type": "derived",
      "formula": "(wisdom - 10) / 2",
      "precision": 0,
      "rounding": "floor"
    },
    {
      "key": "chaMod",
      "label": "Charisma Modifier",
      "type": "derived",
      "formula": "(charisma - 10) / 2",
      "precision": 0,
      "rounding": "floor"
    },
    {
      "key": "level",
      "label": "Level",
      "type": "number",
      "helpText": "Character level (1-20).",
      "min": 1,
      "max": 20,
      "precision": 0,
      "default": 1
    },
    {
      "key": "proficiencyBonus",
      "label": "Proficiency Bonus",
      "type": "derived",
      "helpText": "Added to attack rolls, ability checks, and saving throws you're proficient in. Same formula as the 2014 rules; unchanged in the 2024 revision.",
      "formula": "(level - 1) / 4 + 2",
      "precision": 0,
      "rounding": "floor"
    },
    {
      "key": "class",
      "label": "Class",
      "type": "text",
      "maxLength": 50
    },
    {
      "key": "species",
      "label": "Species",
      "type": "text",
      "helpText": "2024 PHB terminology; replaces the 2014 rules' 'Race'. Species no longer grants an ability score increase in the 2024 rules -- that choice moved to Background (see below).",
      "maxLength": 50
    },
    {
      "key": "background",
      "label": "Background",
      "type": "text",
      "helpText": "2024 PHB backgrounds grant two ability score increases (either +2/+1 to two different abilities or +1/+1/+1 to three) and an origin feat, not just skill/tool proficiencies as in 2014. The app doesn't referee that character-creation math -- it only stores the resulting six ability scores above (already plain number fields regardless of why a given score ended up where it is) and the granted feat in 'Origin Feat' below.",
      "maxLength": 100
    },
    {
      "key": "originFeat",
      "label": "Origin Feat",
      "type": "text",
      "helpText": "The origin feat granted by this character's background (2024 PHB) -- e.g. Alert, Lucky, Magic Initiate, Savage Attacker, Tough. Origin feats are a 2024-only concept; the 2014 rules have no equivalent at character creation.",
      "maxLength": 100
    },
    {
      "key": "alignment",
      "label": "Alignment",
      "type": "enum",
      "options": ["Lawful Good", "Neutral Good", "Chaotic Good", "Lawful Neutral", "True Neutral", "Chaotic Neutral", "Lawful Evil", "Neutral Evil", "Chaotic Evil"]
    },
    {
      "key": "armorClass",
      "label": "Armor Class (AC)",
      "type": "number",
      "helpText": "How hard you are to hit.",
      "min": 1,
      "max": 30,
      "precision": 0
    },
    {
      "key": "hitPoints",
      "label": "Hit Points (HP)",
      "type": "number",
      "helpText": "Current hit points.",
      "min": 0,
      "max": 999,
      "precision": 0
    },
    {
      "key": "hitDice",
      "label": "Hit Dice",
      "type": "text",
      "helpText": "Remaining hit dice for recovery (e.g. '8d8').",
      "maxLength": 20
    },
    {
      "key": "speed",
      "label": "Speed",
      "type": "text",
      "helpText": "Movement speed (e.g. '30 ft.' or '30 ft., fly 60 ft.').",
      "maxLength": 100
    },
    {
      "key": "initiativeProficiencyBonus",
      "label": "Initiative Proficiency Bonus",
      "type": "number",
      "helpText": "2024 rule change: Initiative is now its own proficiency-gated stat (like a skill check using Dexterity) rather than a bare Dexterity modifier as in 2014 -- some feats and class features grant proficiency (or expertise) in it. Enter 0 if not proficient, or a copy of Proficiency Bonus (doubled for expertise) if you are; the Initiative formula below adds this as a plain operand rather than branching on a proficiency flag.",
      "min": 0,
      "max": 12,
      "precision": 0,
      "default": 0
    },
    {
      "key": "initiative",
      "label": "Initiative",
      "type": "derived",
      "helpText": "Dexterity modifier plus Initiative Proficiency Bonus (0 if not proficient). In the 2014 rules this was always just the Dexterity modifier.",
      "formula": "dexMod + initiativeProficiencyBonus",
      "precision": 0
    },
    {
      "key": "perceptionProficiencyBonus",
      "label": "Perception Proficiency Bonus",
      "type": "number",
      "min": 0,
      "max": 12,
      "precision": 0,
      "default": 0
    },
    {
      "key": "passivePerception",
      "label": "Passive Perception",
      "type": "derived",
      "formula": "10 + wisMod + perceptionProficiencyBonus",
      "precision": 0
    },
    {
