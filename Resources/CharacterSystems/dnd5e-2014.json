{
  "formatVersion": 1,
  "id": "dnd5e-2014",
  "name": "D&D 5e (2014)",
  "version": "1.0.0",
  "author": "GM Toolkit",
  "description": "D&D 5th Edition (2014 Player's Handbook and Monster Manual, i.e. the rules before the 2024 revision): race grants an ability score increase directly, backgrounds grant skill/tool proficiencies rather than feats, weapons have no mastery property, and Proficiency Bonus/Initiative aren't printed as their own explicit lines on monster stat blocks the way the 2024 Monster Manual prints them.",
  "pcFields": [
    {
      "key": "strength",
      "label": "Strength",
      "type": "number",
      "helpText": "Physical power and athletic prowess. Record the six ability scores after any racial and other increases directly here.",
      "min": 1,
      "max": 30,
      "precision": 0,
      "default": 10
    },
    {
      "key": "dexterity",
      "label": "Dexterity",
      "type": "number",
      "helpText": "Agility, reflexes, and balance.",
      "min": 1,
      "max": 30,
      "precision": 0,
      "default": 10
    },
    {
      "key": "constitution",
      "label": "Constitution",
      "type": "number",
      "helpText": "Health, stamina, and vital force.",
      "min": 1,
      "max": 30,
      "precision": 0,
      "default": 10
    },
    {
      "key": "intelligence",
      "label": "Intelligence",
      "type": "number",
      "helpText": "Reason and memory.",
      "min": 1,
      "max": 30,
      "precision": 0,
      "default": 10
    },
    {
      "key": "wisdom",
      "label": "Wisdom",
      "type": "number",
      "helpText": "Awareness and insight.",
      "min": 1,
      "max": 30,
      "precision": 0,
      "default": 10
    },
    {
      "key": "charisma",
      "label": "Charisma",
      "type": "number",
      "helpText": "Force of personality and presence.",
      "min": 1,
      "max": 30,
      "precision": 0,
      "default": 10
    },
    {
      "key": "strMod",
      "label": "Strength Modifier",
      "type": "derived",
      "formula": "(strength - 10) / 2",
      "precision": 0,
      "rounding": "floor"
    },
    {
      "key": "dexMod",
      "label": "Dexterity Modifier",
      "type": "derived",
      "formula": "(dexterity - 10) / 2",
      "precision": 0,
      "rounding": "floor"
    },
    {
      "key": "conMod",
      "label": "Constitution Modifier",
      "type": "derived",
      "formula": "(constitution - 10) / 2",
      "precision": 0,
      "rounding": "floor"
    },
    {
      "key": "intMod",
      "label": "Intelligence Modifier",
      "type": "derived",
      "formula": "(intelligence - 10) / 2",
      "precision": 0,
      "rounding": "floor"
    },
    {
      "key": "wisMod",
      "label": "Wisdom Modifier",
      "type": "derived",
      "formula": "(wisdom - 10) / 2",
      "precision": 0,
      "rounding": "floor"
    },
    {
      "key": "chaMod",
      "label": "Charisma Modifier",
      "type": "derived",
      "formula": "(charisma - 10) / 2",
      "precision": 0,
      "rounding": "floor"
    },
    {
      "key": "level",
      "label": "Level",
      "type": "number",
      "helpText": "Character level (1-20).",
      "min": 1,
      "max": 20,
      "precision": 0,
      "default": 1
    },
    {
      "key": "proficiencyBonus",
      "label": "Proficiency Bonus",
      "type": "derived",
      "helpText": "Added to attack rolls, ability checks, and saving throws you're proficient in. Same formula as the 2024 rules; unchanged by the revision.",
      "formula": "(level - 1) / 4 + 2",
      "precision": 0,
      "rounding": "floor"
    },
    {
      "key": "class",
      "label": "Class",
      "type": "text",
      "maxLength": 50
    },
    {
      "key": "race",
      "label": "Race",
      "type": "text",
      "helpText": "2014 PHB terminology. Most races grant an ability score increase directly (e.g. +2 to one ability, +1 to another) -- the app doesn't referee that character-creation math, it only stores the resulting six ability scores above, already plain number fields regardless of why a given score ended up where it is.",
      "maxLength": 50
    },
    {
      "key": "background",
      "label": "Background",
      "type": "text",
      "helpText": "2014 PHB backgrounds grant two skill proficiencies plus tool/language proficiencies and a background feature -- not an ability score increase or a feat, unlike the 2024 revision. Record the resulting skill proficiencies in the Skills group below.",
      "maxLength": 100
    },
    {
      "key": "alignment",
      "label": "Alignment",
      "type": "enum",
      "options": ["Lawful Good", "Neutral Good", "Chaotic Good", "Lawful Neutral", "True Neutral", "Chaotic Neutral", "Lawful Evil", "Neutral Evil", "Chaotic Evil"]
    },
    {
      "key": "armorClass",
      "label": "Armor Class (AC)",
      "type": "number",
      "helpText": "How hard you are to hit.",
      "min": 1,
      "max": 30,
      "precision": 0
    },
    {
      "key": "hitPoints",
      "label": "Hit Points (HP)",
      "type": "number",
      "helpText": "Current hit points.",
      "min": 0,
      "max": 999,
      "precision": 0
    },
    {
      "key": "hitDice",
      "label": "Hit Dice",
      "type": "text",
      "helpText": "Remaining hit dice for recovery (e.g. '8d8').",
      "maxLength": 20
    },
    {
      "key": "speed",
      "label": "Speed",
      "type": "text",
      "helpText": "Movement speed (e.g. '30 ft.' or '30 ft., fly 60 ft.').",
      "maxLength": 100
    },
    {
      "key": "initiativeProficiencyBonus",
      "label": "Initiative Proficiency Bonus",
      "type": "number",
      "helpText": "Proficiency bonus adjustment to initiative (e.g., from the Alert feat). Defaults to 0. Enter a copy of Proficiency Bonus (doubled for expertise) if a feat or feature grants it; the Initiative formula below adds this as a plain operand rather than branching on a proficiency flag.",
      "min": 0,
      "max": 12,
      "precision": 0,
      "default": 0
    },
    {
      "key": "initiative",
      "label": "Initiative",
      "type": "derived",
      "helpText": "Dexterity modifier plus Initiative Proficiency Bonus (0 unless a feat or feature grants proficiency, e.g. the Alert feat).",
      "formula": "dexMod + initiativeProficiencyBonus",
      "precision": 0
    },
    {
      "key": "perceptionProficiencyBonus",
      "label": "Perception Proficiency Bonus",
      "type": "number",
      "min": 0,
      "max": 12,
      "precision": 0,
      "default": 0
    },
    {
      "key": "passivePerception",
      "label": "Passive Perception",
      "type": "derived",
      "formula": "10 + wisMod + perceptionProficiencyBonus",
      "precision": 0
    },
    {
      "key": "strSave",
      "label": "Strength Save",
      "type": "text",
      "helpText": "Proficiency checkbox or modifier",
      "maxLength": 20
    },
    {
      "key": "dexSave",
      "label": "Dexterity Save",
      "type": "text",
      "helpText": "Proficiency checkbox or modifier",
      "maxLength": 20
    },
