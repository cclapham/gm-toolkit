      "maxLength": 20
    },
    {
      "key": "chaSave",
      "label": "Charisma Save",
      "type": "text",
      "helpText": "Proficiency checkbox or modifier",
      "maxLength": 20
    },
    {
      "key": "skills",
      "label": "Skills",
      "type": "repeating-group",
      "helpText": "Skill proficiencies and bonuses. The eighteen skills are unchanged by the 2024 revision.",
      "itemFields": [
        {
          "key": "skillName",
          "label": "Skill",
          "type": "enum",
          "options": ["Acrobatics", "Animal Handling", "Arcana", "Athletics", "Deception", "History", "Insight", "Intimidation", "Investigation", "Medicine", "Nature", "Perception", "Performance", "Persuasion", "Religion", "Sleight of Hand", "Stealth", "Survival"]
        },
