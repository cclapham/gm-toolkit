<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:GmToolkit.UI.ViewModels"
             xmlns:converters="using:Avalonia.Data.Converters"
             mc:Ignorable="d" d:DesignWidth="480" d:DesignHeight="500"
             x:Class="GmToolkit.UI.Views.CampaignFormView"
             x:DataType="vm:CampaignFormViewModel">
    <Design.DataContext>
        <vm:CampaignFormViewModel />
    </Design.DataContext>

    <!-- Shared create/edit form (#18), see CampaignFormViewModel's remarks for the validation
         approach and the unsaved-changes guard. Embedded in-place inside CampaignsView.axaml
         rather than shown as a separate Window/destination, see CampaignsViewModel's remarks. -->
    <StackPanel Spacing="{StaticResource SpaceMD}" MaxWidth="480" HorizontalAlignment="Left">
        <TextBlock Classes="title" Foreground="{DynamicResource TextBrush}" Text="{Binding FormTitle}" />

        <StackPanel IsVisible="{Binding IsFieldsVisible}" Spacing="{StaticResource SpaceMD}">
            <StackPanel Spacing="{StaticResource SpaceXS}">
                <TextBlock Classes="caption" Text="Name" />
                <!-- No separate error TextBlock here: TextBox's Fluent control theme already
                     renders INotifyDataErrorInfo errors for a bound property automatically (red
                     border plus the error message itself) since CampaignFormViewModel implements
                     it via ObservableValidator, so adding our own duplicated that text (confirmed
                     visually while checking this screen: without this fix, "Campaign name is
                     required." rendered twice). NameError stays on the view model regardless, for
                     tests to assert against directly. -->
                <TextBox Text="{Binding Name, Mode=TwoWay}" PlaceholderText="e.g. Wandering Souls" />
            </StackPanel>

            <StackPanel Spacing="{StaticResource SpaceXS}">
                <TextBlock Classes="caption" Text="Game system" />
                <TextBox Text="{Binding GameSystem, Mode=TwoWay}" PlaceholderText="e.g. D&amp;D 5e, Call of Cthulhu, Blades in the Dark" />
            </StackPanel>

            <StackPanel Spacing="{StaticResource SpaceXS}">
                <TextBlock Classes="caption" Text="Description" />
                <TextBox Text="{Binding Description, Mode=TwoWay}"
                         PlaceholderText="What's this campaign about?"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         Height="96" />
            </StackPanel>

            <TextBlock Classes="caption"
                       Foreground="{DynamicResource DangerBrush}"
                       Text="{Binding SaveError}"
                       TextWrapping="Wrap"
                       IsVisible="{Binding SaveError, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}" />

            <!-- Spacing="8" mirrors SpaceSM, see the note in Styles/Spacing.axaml. -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="accent"
                        Content="{Binding SaveButtonLabel}"
                        Command="{Binding SaveCommand}"
                        IsEnabled="{Binding CanSave}" />
                <Button Content="Cancel" Command="{Binding CancelCommand}" />
            </StackPanel>
        </StackPanel>

        <!-- Inline unsaved-changes guard, no popup dialog (see CampaignFormViewModel's remarks
             and this app's no-popup-Windows constraint, since Android has no equivalent). -->
        <Border IsVisible="{Binding IsShowingDiscardConfirmation}"
                Background="{DynamicResource SurfaceAltBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
            <StackPanel Spacing="8">
                <TextBlock Classes="body" Foreground="{DynamicResource TextBrush}" Text="Discard unsaved changes?" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <!-- "Keep editing" (the safe, non-destructive default) gets the accent
                         styling; "Discard changes" stays plain so the more consequential action
                         isn't the visually louder one. -->
                    <Button Classes="accent" Content="Keep editing" Command="{Binding CancelDiscardCommand}" />
                    <Button Content="Discard changes" Command="{Binding ConfirmDiscardCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
