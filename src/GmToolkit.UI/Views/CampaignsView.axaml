<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:GmToolkit.UI.ViewModels"
             xmlns:views="using:GmToolkit.UI.Views"
             xmlns:controls="using:GmToolkit.UI.Controls"
             xmlns:converters="using:Avalonia.Data.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="GmToolkit.UI.Views.CampaignsView"
             x:DataType="vm:CampaignsViewModel">
    <Design.DataContext>
        <vm:CampaignsViewModel />
    </Design.DataContext>

    <UserControl.Styles>
        <!-- Campaign list row chrome. A plain, non-interactive Border (not a Button as before
             #19): the row now holds two independently-clickable elements side by side - the
             "select" button and the "delete" trigger - and Avalonia's Button-in-Button click
             routing is unreliable (the outer button tends to swallow or fight with an inner
             button's pointer events), so the outer container can no longer itself be a Button. -->
        <Style Selector="Border.campaignRow">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Border.campaignRow.active">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>

        <!-- The "select" click target: everything but chrome, now unstyled/transparent so it
             reads as part of the row rather than a nested button, matching the look the single
             Button.campaignRow used to have on its own. -->
        <Style Selector="Button.campaignRowSelect">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <!-- Padding="12" mirrors SpaceMD, see the note in Styles/Spacing.axaml. -->
            <Setter Property="Padding" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.campaignRowSelect:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
        </Style>

        <!-- The "edit" (issue #71), "expand/collapse" (issue #72) and "delete" triggers: all
             siblings of campaignRowSelect (not nested inside it - see this style block's opening
             comment), so none of their clicks also selects the campaign. -->
        <Style Selector="Button.campaignRowEdit">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <!-- Padding="8,12" mirrors SpaceSM/SpaceMD, see the note in Styles/Spacing.axaml. -->
            <Setter Property="Padding" Value="8,12" />
        </Style>
        <Style Selector="Button.campaignRowEdit:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
        </Style>
        <Style Selector="Button.campaignRowExpand">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <!-- Padding="8,12" mirrors SpaceSM/SpaceMD, see the note in Styles/Spacing.axaml. -->
            <Setter Property="Padding" Value="8,12" />
        </Style>
        <Style Selector="Button.campaignRowExpand:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
        </Style>
        <Style Selector="Button.campaignRowDelete">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
            <!-- Padding="8,12" mirrors SpaceSM/SpaceMD, see the note in Styles/Spacing.axaml. -->
            <Setter Property="Padding" Value="8,12" />
        </Style>
        <Style Selector="Button.campaignRowDelete:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
        </Style>
    </UserControl.Styles>

    <!-- Padding="24" mirrors SpaceLG, see the note in Styles/Spacing.axaml. -->
    <Border Background="{DynamicResource BgBrush}" Padding="24">
        <Grid RowDefinitions="Auto,*" MaxWidth="640" HorizontalAlignment="Stretch">
            <!-- List-mode header: title + Create button. Hidden for the empty state (which has
                 its own heading and a more prominent Create button) and while the form is showing
                 (which has its own "Create Campaign"/"Edit Campaign" heading). WrapPanel (not a
                 Grid with "*,Auto" columns) so the button drops to its own line at phone-portrait
                 widths instead of visually overlapping the title: a Grid column's child can
                 render past its column's edge when its desired size doesn't fit, which is exactly
                 what happened here before this fix. -->
            <WrapPanel Grid.Row="0" IsVisible="{Binding IsListVisible}" Margin="0,0,0,16">
                <TextBlock Classes="display"
                           Foreground="{DynamicResource TextBrush}"
                           Text="Campaigns"
                           VerticalAlignment="Center"
                           Margin="0,0,16,8" />
                <Button Classes="accent" Content="+ Create Campaign" Command="{Binding ShowCreateFormCommand}" Margin="0,0,0,8" />
            </WrapPanel>

            <!-- Load-error state: shown instead of the empty state or the list if loading threw,
                 so a database read failure doesn't leave IsLoading stuck true with a spinner that
                 never resolves and no way forward. -->
            <StackPanel Grid.Row="1"
                        IsVisible="{Binding HasLoadError}"
                        Spacing="{StaticResource SpaceMD}"
                        MaxWidth="480"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center">
                <TextBlock Classes="display" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" Text="Couldn't load your campaigns" />
                <TextBlock Classes="body" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Text="{Binding LoadError}" />
                <Button Classes="accent" Content="Try again" Command="{Binding RetryLoadCommand}" HorizontalAlignment="Left" />
            </StackPanel>

            <!-- Loading state (#23): shown while the initial GetAllAsync read is in flight, so a
                 slow load (e.g. on Raspberry Pi 4 hardware) never shows a blank area with nothing
                 explaining what's happening — see LoadingIndicator's remarks for why a spinner,
                 not a skeleton layout, is proportionate here. -->
            <controls:LoadingIndicator Grid.Row="1"
                                        IsVisible="{Binding IsLoading}"
                                        Message="Loading campaigns..." />

            <!-- Empty state (#17): a first-time user with zero campaigns needs no instructions
                 beyond this: explain what a campaign is, and the only actionable next step is
                 right here. Uses the reusable EmptyState control (#23) — see its remarks for the
                 icon/heading/message/call-to-action design. -->
            <controls:EmptyState Grid.Row="1"
                                  IsVisible="{Binding IsEmpty}"
                                  Icon="🗺️"
                                  Title="Welcome to GM Toolkit"
                                  Message="A campaign is your game -- it holds its player characters and NPCs, and everything else you track while running it. Create your first one to get started."
                                  ActionText="Create your first campaign"
                                  ActionCommand="{Binding ShowCreateFormCommand}" />

            <!-- Populated list, sorted by last opened (newest first). -->
            <ScrollViewer Grid.Row="1" IsVisible="{Binding IsListVisible}">
                <ItemsControl ItemsSource="{Binding Campaigns}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="{StaticResource SpaceSM}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CampaignListItemViewModel">
                            <!-- Non-interactive Border wraps the whole row; the "select" button
                                 and the "delete" trigger below are siblings inside it, not nested
                                 inside one another - see this view's Styles block for why. -->
                            <Border Classes="campaignRow" Classes.active="{Binding IsActive}">
                                <StackPanel>
                                    <!-- Stacked content within the select button (not a fixed-
                                         column Grid): a Grid's "*" column can be squeezed to zero
                                         width by sibling "Auto" columns at narrow widths, which
                                         made the campaign's name disappear entirely on
                                         phone-portrait (verified visually while checking this
                                         screen at 380px wide). Stacking top-to-bottom has no such
                                         failure mode at any width. The row itself still needs a
                                         "*,Auto" Grid to place the delete trigger beside it, but
                                         that column only ever holds one fixed-size button, not
                                         wrapping text, so it isn't at risk of the same failure. -->
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Button Grid.Column="0"
                                                Classes="campaignRowSelect"
                                                Command="{Binding $parent[UserControl].((vm:CampaignsViewModel)DataContext).SelectCommand}"
                                                CommandParameter="{Binding}">
                                            <StackPanel Spacing="{StaticResource SpaceXS}">
                                                <TextBlock Classes="subtitle" Foreground="{DynamicResource TextBrush}" Text="{Binding Name}" TextWrapping="Wrap" />
                                                <TextBlock Classes="caption" Text="{Binding GameSystem}" TextWrapping="Wrap" />
                                                <WrapPanel>
                                                    <TextBlock Classes="caption" Text="{Binding CountsLabel}" Margin="0,0,16,0" />
                                                    <TextBlock Classes="caption" Text="{Binding LastOpenedUtc, StringFormat='Opened {0:MMM d, yyyy}'}" Margin="0,0,16,0" />
                                                    <TextBlock Classes="caption"
                                                               Foreground="{DynamicResource AccentBrush}"
                                                               FontWeight="Bold"
                                                               Text="Active"
                                                               IsVisible="{Binding IsActive}" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </Button>
                                        <!-- Expand/collapse (issue #72), edit (issue #71) and delete (issue #19) triggers, side
                                             by side: all siblings of campaignRowSelect above (not nested inside it - see this
                                             view's Styles block), so none of their clicks also activates the campaign. -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button Classes="campaignRowExpand"
                                                    Command="{Binding $parent[UserControl].((vm:CampaignsViewModel)DataContext).ToggleExpandedCommand}"
                                                    CommandParameter="{Binding}"
                                                    Content="{Binding ExpandToggleLabel}" />
                                            <Button Classes="campaignRowEdit"
                                                    Command="{Binding $parent[UserControl].((vm:CampaignsViewModel)DataContext).RequestEditCommand}"
                                                    CommandParameter="{Binding}"
                                                    Content="Edit" />
                                            <Button Classes="campaignRowDelete"
                                                    Command="{Binding $parent[UserControl].((vm:CampaignsViewModel)DataContext).RequestDeleteCommand}"
                                                    CommandParameter="{Binding}"
                                                    Content="Delete" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Expanded overview panel (issue #72): collapsed by default, toggled per row by the
                                         "More"/"Less" button above. Additive alongside the compact summary line inside
                                         campaignRowSelect (CountsLabel/LastOpenedUtc/Active badge), which stays visible in
                                         both states - this only adds Description (with a placeholder instead of an empty
                                         gap when blank) and CreatedUtc, formatted the same way LastOpenedUtc already is
                                         above. -->
                                    <StackPanel IsVisible="{Binding IsExpanded}"
                                                Spacing="{StaticResource SpaceXS}"
                                                Margin="12,0,12,12">
                                        <TextBlock Classes="body" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" Text="{Binding DescriptionOrPlaceholder}" />
                                        <TextBlock Classes="caption" Text="{Binding CreatedUtc, StringFormat='Created {0:MMM d, yyyy}'}" />
                                    </StackPanel>

                                    <!-- Inline delete-confirmation panel (issue #19): same
                                         no-popup-dialog idiom as CampaignFormView.axaml's discard
                                         guard (Android's single-view lifetime has no popup-Window
                                         equivalent). Names the campaign and states the PC/NPC
                                         counts it will destroy (DeleteConfirmationPrompt), and
                                         requires typing the campaign's exact name into
                                         DeleteConfirmationInput before ConfirmDeleteCommand's
                                         CanExecute (CanConfirmDelete) allows the delete button to
                                         actually run - see CampaignsViewModel.CanConfirmDelete's
                                         remarks for why type-to-confirm was chosen over a second
                                         click. -->
                                    <Border IsVisible="{Binding IsShowingDeleteConfirmation}"
                                            Background="{DynamicResource SurfaceAltBrush}"
                                            BorderBrush="{DynamicResource DangerBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Margin="12,0,12,12"
                                            Padding="16">
                                        <StackPanel Spacing="{StaticResource SpaceSM}">
                                            <TextBlock Classes="body"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       TextWrapping="Wrap"
                                                       Text="{Binding DeleteConfirmationPrompt}" />
                                            <TextBlock Classes="caption" Text="Type the campaign name to confirm:" />
                                            <TextBox Text="{Binding $parent[UserControl].((vm:CampaignsViewModel)DataContext).DeleteConfirmationInput, Mode=TwoWay}"
                                                     PlaceholderText="{Binding Name}" />
                                            <TextBlock Classes="caption"
                                                       Foreground="{DynamicResource DangerBrush}"
                                                       Text="{Binding $parent[UserControl].((vm:CampaignsViewModel)DataContext).DeleteError}"
                                                       TextWrapping="Wrap"
                                                       IsVisible="{Binding $parent[UserControl].((vm:CampaignsViewModel)DataContext).DeleteError, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}" />
                                            <!-- "Cancel" (the safe, non-destructive default) gets
                                                 the accent styling; "Delete campaign" stays plain
                                                 so the more consequential action isn't the
                                                 visually louder one - same convention as
                                                 CampaignFormView.axaml's discard guard. -->
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button Classes="accent"
                                                        Content="Cancel"
                                                        Command="{Binding $parent[UserControl].((vm:CampaignsViewModel)DataContext).CancelDeleteCommand}" />
                                                <Button Content="Delete campaign"
                                                        Foreground="{DynamicResource DangerBrush}"
                                                        Command="{Binding $parent[UserControl].((vm:CampaignsViewModel)DataContext).ConfirmDeleteCommand}"
                                                        IsEnabled="{Binding $parent[UserControl].((vm:CampaignsViewModel)DataContext).CanConfirmDelete}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- In-place create/edit form (#18), see CampaignsViewModel's remarks for why this
                 is a mode switch within this one screen rather than a separate Window/destination. -->
            <ContentControl Grid.Row="1" IsVisible="{Binding IsFormVisible}">
                <views:CampaignFormView DataContext="{Binding Form}" />
            </ContentControl>
        </Grid>
    </Border>
</UserControl>
