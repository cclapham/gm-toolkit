<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:GmToolkit.UI.ViewModels"
             xmlns:views="using:GmToolkit.UI.Views"
             xmlns:controls="using:GmToolkit.UI.Controls"
             xmlns:converters="using:Avalonia.Data.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="GmToolkit.UI.Views.NpcsView"
             x:DataType="vm:NpcsViewModel">
    <Design.DataContext>
        <vm:NpcsViewModel />
    </Design.DataContext>

    <UserControl.Styles>
        <!-- NPC list row chrome. Now a click target (issue #25's click-through to edit, see
             NpcsViewModel.SelectCommand), so, same "whole row is one Button" idiom as
             CharactersView.axaml's characterRow, this is a Button, not a Border. The
             known-to-players badge inside the row stays a Border (not a Button), so there's still
             no Button-in-Button ambiguity. -->
        <Style Selector="Button.npcRow">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <!-- Padding="12" mirrors SpaceMD, see the note in Styles/Spacing.axaml. -->
            <Setter Property="Padding" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.npcRow:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
        </Style>

        <!-- "Known to players" badge: SuccessBrush (not AccentBrush, which CampaignsView.axaml
             already uses to mean "this is the active campaign") reads as its own distinct
             "safe/visible" signal rather than colliding with that unrelated meaning. -->
        <Style Selector="Border.knownToPlayersBadge">
            <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="8,2" />
        </Style>
        <Style Selector="Border.knownToPlayersBadge TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <!-- Sort-order toggle: two plain Buttons rather than a ComboBox, since there are only two
             options and this reads faster at a glance during a session than opening a dropdown,
             and the active one gets the same "accent" look Button.accent already uses elsewhere
             for "the current thing"; the inactive one stays a plain default Button. -->
        <Style Selector="Button.sortOption.active">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Styles>

    <!-- Padding="24" mirrors SpaceLG, see the note in Styles/Spacing.axaml. -->
    <Border Background="{DynamicResource BgBrush}" Padding="24">
        <Grid RowDefinitions="Auto,Auto,*" MaxWidth="720" HorizontalAlignment="Stretch">
            <!-- Title + "+ Add NPC" (issue #25). The button is bound to IsSearchBarVisible rather
                 than IsListVisible (unlike CharactersView.axaml's header button, which is only
                 gated on its two-state IsListVisible), IsSearchBarVisible is already true for
                 both IsListVisible and IsNoSearchResults (both show the search bar, see
                 NpcsViewModel.IsSearchBarVisible's remarks), so this one binding covers both
                 populated-list states without a new property, while the Empty state below keeps its
                 own dedicated "Add your first NPC" button (same split CharactersView.axaml uses). -->
            <WrapPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Classes="display"
                           Foreground="{DynamicResource TextBrush}"
                           Text="NPCs"
                           VerticalAlignment="Center"
                           Margin="0,0,16,8" />
                <Button Classes="accent"
                        Content="+ Add NPC"
                        Command="{Binding ShowCreateFormCommand}"
                        IsVisible="{Binding IsSearchBarVisible}"
                        Margin="0,0,0,8" />
            </WrapPanel>

            <!-- Search/filter/sort bar (issue #24), only shown once there's at least one NPC to
                 search, filter or sort; see NpcsViewModel.IsSearchBarVisible's remarks. WrapPanel
                 (not a fixed-column Grid) so the controls drop to their own lines at narrow widths
                 instead of overlapping, same idiom as CharactersView.axaml's header. -->
            <WrapPanel Grid.Row="1" IsVisible="{Binding IsSearchBarVisible}" Margin="0,0,0,16">
                <TextBox Text="{Binding SearchText, Mode=TwoWay}"
                         PlaceholderText="Search name, role, faction, location, notes"
                         Width="280"
                         Margin="0,0,8,8" />
                <StackPanel Spacing="{StaticResource SpaceXS}" Margin="0,0,8,8">
                    <TextBlock Classes="caption" Text="Faction" />
                    <ComboBox ItemsSource="{Binding FactionOptions}" SelectedItem="{Binding SelectedFaction, Mode=TwoWay}" MinWidth="140" />
                </StackPanel>
                <StackPanel Spacing="{StaticResource SpaceXS}" Margin="0,0,8,8">
                    <TextBlock Classes="caption" Text="Location" />
                    <ComboBox ItemsSource="{Binding LocationOptions}" SelectedItem="{Binding SelectedLocation, Mode=TwoWay}" MinWidth="140" />
                </StackPanel>
                <StackPanel Spacing="{StaticResource SpaceXS}" Margin="0,0,8,8">
                    <TextBlock Classes="caption" Text="Sort by" />
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button Classes="sortOption" Classes.active="{Binding IsSortedByName}" Content="Name" Command="{Binding SortByNameCommand}" />
                        <Button Classes="sortOption" Classes.active="{Binding IsSortedByRecentlyAdded}" Content="Recently added" Command="{Binding SortByRecentlyAddedCommand}" />
                    </StackPanel>
                </StackPanel>

                <!-- Only shown once search/faction/location is actually narrowing the list (see
                     NpcsViewModel.HasActiveFilters's remarks). Resets all three in one action
                     instead of the search box and both dropdowns individually. Bottom-aligned so it
                     lines up with the button row of the captioned groups above rather than their
                     captions. -->
                <Button Content="Clear filters"
                        Command="{Binding ClearFiltersCommand}"
                        IsVisible="{Binding HasActiveFilters}"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,8" />
            </WrapPanel>

            <!-- Load-error state: mirrors CharactersView.axaml's identical state, so a database
                 read failure doesn't leave IsLoading stuck true with nothing shown. -->
            <StackPanel Grid.Row="2"
                        IsVisible="{Binding HasLoadError}"
                        Spacing="{StaticResource SpaceMD}"
                        MaxWidth="480"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center">
                <TextBlock Classes="display" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" Text="Couldn't load this campaign's NPCs" />
                <TextBlock Classes="body" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Text="{Binding LoadError}" />
                <Button Classes="accent" Content="Try again" Command="{Binding RetryLoadCommand}" HorizontalAlignment="Left" />
            </StackPanel>

            <!-- Loading state (#23): mirrors CampaignsView.axaml/CharactersView.axaml's identical
                 state, so a slow load never shows a blank area with nothing explaining what's
                 happening. -->
            <controls:LoadingIndicator Grid.Row="2"
                                        IsVisible="{Binding IsLoading}"
                                        Message="Loading NPCs..." />

            <!-- Empty state: the active campaign has no NPCs yet at all. Has its own dedicated
                 create button (issue #25); the header's "+ Add NPC" button above is bound to
                 IsSearchBarVisible, which is false here (see that binding's remarks), so this state
                 needs its own, same split as CharactersView.axaml/CampaignsView.axaml's empty
                 states. Uses the reusable EmptyState control (#23) — see its remarks. -->
            <controls:EmptyState Grid.Row="2"
                                  IsVisible="{Binding IsEmpty}"
                                  Icon="🎭"
                                  Title="No NPCs yet"
                                  Message="This is where the active campaign's non-player characters live, with search and filter by faction/location. Add your first NPC to get started."
                                  ActionText="Add your first NPC"
                                  ActionCommand="{Binding ShowCreateFormCommand}" />

            <!-- No-search-results state, distinct from IsEmpty above: the campaign has NPCs, but
                 none match the current search/filter. See NpcsViewModel.IsNoSearchResults's remarks.
                 Also uses EmptyState (#23), with IsCompact="True" to keep this state's previous,
                 less prominent "title" heading look (it's a transient nudge, not a first-run
                 "welcome" moment) and no ActionText/ActionCommand — there's nothing actionable to
                 do here beyond adjusting the search/filter controls already on screen, so
                 EmptyState.HasAction is false and no button renders. -->
            <controls:EmptyState Grid.Row="2"
                                  IsVisible="{Binding IsNoSearchResults}"
                                  Icon="🔍"
                                  IsCompact="True"
                                  Title="No NPCs match your search"
                                  Message="Try a different search term, or reset the faction/location filter back to All." />

            <!-- Populated list. Each row is compact and fixed-height (NotesPreview is single-line,
                 ellipsis-truncated, see NpcListItemViewModel's remarks) so a list of 100 NPCs
                 stays scannable rather than each row growing to fit its longest field, which
                 matters for this issue's "find one NPC in a list of 100 in under 5 seconds"
                 acceptance criterion just as much as the search/filter/sort themselves do. -->
            <ScrollViewer Grid.Row="2" IsVisible="{Binding IsListVisible}">
                <ItemsControl ItemsSource="{Binding Npcs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="{StaticResource SpaceSM}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:NpcListItemViewModel">
                            <Button Classes="npcRow"
                                    Command="{Binding $parent[UserControl].((vm:NpcsViewModel)DataContext).SelectCommand}"
                                    CommandParameter="{Binding}">
                                <StackPanel Spacing="{StaticResource SpaceXS}">
                                    <WrapPanel>
                                        <TextBlock Classes="subtitle" Foreground="{DynamicResource TextBrush}" Text="{Binding Name}" Margin="0,0,16,0" />
                                        <!-- Known-to-players badge (issue #24's own task): visible
                                             only for NPCs the players already know about, next to
                                             the name so it's the first thing a GM's eye catches
                                             when scanning the row. Stays a Border, not a Button;
                                             see UserControl.Styles' remark on Button.npcRow. -->
                                        <Border Classes="knownToPlayersBadge" IsVisible="{Binding KnownToPlayers}" Margin="0,0,16,0">
                                            <TextBlock Classes="caption" Text="Known to players" />
                                        </Border>
                                        <TextBlock Classes="caption" Text="{Binding Role}" Margin="0,0,16,0" IsVisible="{Binding Role, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}" />
                                        <TextBlock Classes="caption" Text="{Binding Faction, StringFormat='Faction: {0}'}" Margin="0,0,16,0" IsVisible="{Binding Faction, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}" />
                                        <TextBlock Classes="caption" Text="{Binding Location, StringFormat='Location: {0}'}" IsVisible="{Binding Location, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}" />
                                    </WrapPanel>
                                    <!-- Single line, no wrap, ellipsis-truncated: an NPC with a
                                         long notes field truncates gracefully instead of growing
                                         this row's height, see NotesPreview's remarks. -->
                                    <TextBlock Classes="caption"
                                               Text="{Binding NotesPreview}"
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- In-place create/edit form (#25), see NpcsViewModel's remarks for why this is a mode
                 switch within this one screen rather than a separate Window/destination. -->
            <ContentControl Grid.Row="2" IsVisible="{Binding IsFormVisible}">
                <views:NpcFormView DataContext="{Binding Form}" />
            </ContentControl>
        </Grid>
    </Border>
</UserControl>
