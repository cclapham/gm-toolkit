<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--If you are willing to use platform-specific APIs, use conditional compilation.
    See https://docs.avaloniaui.net/docs/guides/platforms/platform-specific-code/dotnet for more details.-->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Multi-resolution (16-256px) source icon shared from repo-root Resources/Icons/, same
    convention as GmToolkit.Core's GeneratorTables embedding; sets the .exe's icon on Windows. -->
    <ApplicationIcon>..\..\Resources\Icons\GM-Toolkit-logo-256.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GmToolkit.UI\GmToolkit.UI.csproj" />
    <ProjectReference Include="..\GmToolkit.Data\GmToolkit.Data.csproj" />
    <ProjectReference Include="..\GmToolkit.Core\GmToolkit.Core.csproj" />
  </ItemGroup>
</Project>
