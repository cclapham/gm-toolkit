<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ApplicationId>com.clapham.gmtoolkit</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
  </PropertyGroup>

  <ItemGroup>
    <!-- Shared source icon from repo-root Resources/Icons/ (see GmToolkit.Core's GeneratorTables
    embedding for the same pattern); used for the launcher icon and splash_screen.xml. -->
    <!-- Android's resource compiler validates the source file's own name against
    [a-zA-Z0-9_.]+ (no hyphens, no uppercase), regardless of the Link below, hence the
    underscored/lowercase filename here rather than matching Resources/Icons/'s usual naming. -->
    <AndroidResource Include="..\..\Resources\Icons\gmtoolkit_icon_256.png">
      <Link>Resources\drawable\Icon.png</Link>
    </AndroidResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Xamarin.AndroidX.Core.SplashScreen" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GmToolkit.UI\GmToolkit.UI.csproj" />
    <ProjectReference Include="..\GmToolkit.Data\GmToolkit.Data.csproj" />
    <ProjectReference Include="..\GmToolkit.Core\GmToolkit.Core.csproj" />
  </ItemGroup>
</Project>
